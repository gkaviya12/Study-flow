# Server environment variables
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=studyflow_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
COOKIE_NAME=studyflow-jwt
JWT_COOKIE_MAX_AGE=7 * 24 * 60 * 60  # 7 days

# CORS
CLIENT_URL=http://localhost:5173

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=no-reply@studyflow.com

RESET_TOKEN_EXPIRY_MINUTES=60